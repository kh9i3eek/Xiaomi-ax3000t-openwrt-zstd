#!/bin/sh

# Включаем оба радиоинтерфейса
uci set wireless.radio0.disabled='0'
uci set wireless.radio1.disabled='0'

# Устанавливаем регион Панама (PA)
uci set wireless.radio0.country='PA'
uci set wireless.radio1.country='PA'

# Настраиваем 2.4 ГГц (без пароля)
uci set wireless.default_radio0.disabled='0'
uci set wireless.default_radio0.ssid='OpenWrt'
uci set wireless.default_radio0.encryption='none'

# Настраиваем 5 ГГц (без пароля)
uci set wireless.default_radio1.disabled='0'
uci set wireless.default_radio1.ssid='OpenWrt_5G'
uci set wireless.default_radio1.encryption='none'

# Сохраняем и применяем
uci commit wireless
wifi reload
exit 0
